/* Firestore security rules — the readable source of truth.
 *
 * The console holds the same rules on a single line, because its editor
 * auto-closes braces and fights multi-line typing. This file is what to edit
 * and review; paste it into the console (or `firebase deploy --only
 * firestore:rules`) when it changes.
 *
 * The property that matters: a signed-in client can read and write its own
 * document and its own designs, but can NEVER set the fields that grant Pro.
 * Those are refused on create and on update, so entitlement can only come
 * from a trusted server — a Cloud Function with the Admin SDK, or a human in
 * the console. Without that, "paid tier" would mean nothing: anyone could
 * write pro: true from the browser console.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* Fields only a trusted server may set — the Stripe webhook, through the
       Admin SDK, which bypasses these rules. Every field the webhook writes
       must appear here; functions/test-entitlement.js asserts that from the
       other side, so adding a field to the webhook without adding it here
       fails the test rather than quietly opening a hole. */
    function locked() {
      return ['pro', 'proSince', 'proSource', 'proStatus', 'proUpdatedAt',
              'stripeCustomerId', 'stripeSubscriptionId', 'stripeLivemode'];
    }

    /* The footer a Pro subscriber prints instead of our credit. It is their
       own text, so it is writable — but it lands on paper, and an unbounded
       string is a way to make a mess of someone else's sheet or of our
       storage. Bounded rather than forbidden. Entitlement is not checked
       here: writing it while not Pro is harmless, because brand.js only
       reads it when pro is true. */
    function footerOk() {
      return !('sheetFooter' in request.resource.data)
             || (request.resource.data.sheetFooter is string
                 && request.resource.data.sheetFooter.size() <= 64);
    }

    match /users/{uid} {
      allow read:   if signedInAs(uid);
      allow delete: if signedInAs(uid);
      allow create: if signedInAs(uid)
                    && !request.resource.data.keys().hasAny(locked())
                    && footerOk();
      allow update: if signedInAs(uid)
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(locked())
                    && footerOk();

      /* A user's saved designs. Only ever their own. */
      match /designs/{designId} {
        allow read, write: if signedInAs(uid);
      }
    }
  }
}
